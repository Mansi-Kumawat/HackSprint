# PostgreSQL connection string (server-side only — never expose to the client).
#
# Local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db"
#
# Supabase (Project Settings → Database → Connection string → Session pooler):
# DATABASE_URL="postgresql://postgres.<project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# IMPORTANT: keep this variable server-only. Do NOT prefix it with NEXT_PUBLIC_.
# All database access happens in server route handlers / server components.
